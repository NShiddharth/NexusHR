# NexusHR — Environment Configuration Template
# Copy this file to .env and fill in all values before running Docker Compose.
# The .env file is listed in .gitignore and must NEVER be committed to source control.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your generated secrets

# ============================================================
# JWT Authentication Secret (REQUIRED — MUST be changed)
# ============================================================
# Generate a cryptographically random 256-bit (32-byte) secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# The value below is a placeholder. Using it in production is a critical security defect.
JWT_SECRET=CHANGE_ME_generate_with_secrets.token_hex_32

# ============================================================
# PostgreSQL Credentials
# ============================================================
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_DB=nexus_employee_db

# ============================================================
# Optional overrides (defaults are safe for local Docker use)
# ============================================================
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
